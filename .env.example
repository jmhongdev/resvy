DB_HOST=localhost
DB_PORT=5432
DB_NAME=resvy
DB_USER=resvy_user
DB_PASSWORD=resvy_pass

# Replace with a random 64-character string before deploying
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_use_a_long_random_string
JWT_REFRESH_SECRET=changeme_another_long_random_string

PORT=3000

# Set to frontend domain in production e.g. https://resvy.com
CORS_ORIGIN=http://localhost:5173

API_URL=http://localhost:3000